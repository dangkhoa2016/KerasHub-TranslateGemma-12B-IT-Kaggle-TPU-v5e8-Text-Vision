# TranslateGemma 12B IT / Kaggle TPU v5e-8 v1.0.0
HOST=0.0.0.0
PORT=7860
MODEL_BASE=/kaggle/input/models/keras/translategemma/keras/translategemma_12b_it
MODEL_PATH=
EXPECTED_TPU_DEVICES=8
EXPECTED_LIBTPU_VERSION=0.0.17
INSTALL_LIBTPU_IF_MISSING=auto
TPU_PREFLIGHT_MODE=required
REQUIRE_V5E8=true
MESH_SHAPE=1,8
MESH_AXIS_NAMES=batch,model
DATA_PARALLEL_AXIS=batch
MODEL_PARALLEL_AXIS=model
MODEL_DTYPE=bfloat16
VISION_ENABLED=true
GENERATION_SPLIT_COMPILE=true
GENERATION_BUCKETING=true
GENERATION_LENGTH_BUCKETS=256,512,1024
GENERATION_BUCKET_STEP=512
VISION_MIN_GENERATION_LENGTH=512
DEFAULT_OUTPUT_TOKENS=128
MAX_OUTPUT_TOKENS=1024
MAX_INPUT_CHARS=20000
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=20000000
MAX_REQUEST_BYTES=8388608
MAX_QUEUE_SIZE=16
MAX_STORE_SIZE=500
RESULT_TTL_SECONDS=3600
REQUEST_TIMEOUT=600
SHUTDOWN_TIMEOUT=300
WORKER_LOAD_TIMEOUT=1200
START_LIVENESS_TIMEOUT=30
MAX_WORKER_RESTARTS=1
API_AUTH_REQUIRED=true
API_KEY=
RESTART_SECRET=
JAX_PLATFORMS=tpu,cpu
JAX_COMPILATION_CACHE_DIR=/kaggle/working/.cache/translategemma-12b-jax
JAX_PERSISTENT_CACHE_MIN_COMPILE_TIME_SECS=1.0
JAX_PERSISTENT_CACHE_MIN_ENTRY_SIZE_BYTES=-1
KAGGLE_TPU_FALLBACK=auto
